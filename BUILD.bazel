load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_cc//cc:defs.bzl", "cc_binary")

cargo_build_script(
    name = "stamped_build",
    srcs = ["build.rs"],
    build_script_env = {"TARRO_DESKTOP_FLEET_VERSION": "0.0.1.0"},
)

cargo_build_script(
    name = "unstamped_build",
    srcs = ["build.rs"],
)

rust_binary(
    name = "stamped",
    features = ["-linker_subsystem_flag"],
    srcs = ["policy.rs"],
    deps = [":stamped_build"],
)

rust_binary(
    name = "unstamped",
    features = ["-linker_subsystem_flag"],
    srcs = ["policy.rs"],
    deps = [":unstamped_build"],
)

cc_binary(
    name = "native_console",
    srcs = ["main.cc"],
)

rust_binary(
    name = "gui",
    srcs = ["main.rs"],
)

rust_binary(
    name = "override_only",
    srcs = ["plain.rs"],
    rustc_flags = ["-Clink-arg=/SUBSYSTEM:WINDOWS"],
)

rust_binary(
    name = "override_with_entry",
    srcs = ["plain.rs"],
    rustc_flags = [
        "-Clink-arg=/SUBSYSTEM:WINDOWS",
        "-Clink-arg=/ENTRY:mainCRTStartup",
    ],
)
