load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "gui",
    srcs = ["main.rs"],
)

rust_binary(
    name = "override_only",
    srcs = ["plain.rs"],
    rustc_flags = ["-Clink-arg=/SUBSYSTEM:WINDOWS"],
)

rust_binary(
    name = "override_with_entry",
    srcs = ["plain.rs"],
    rustc_flags = [
        "-Clink-arg=/SUBSYSTEM:WINDOWS",
        "-Clink-arg=/ENTRY:mainCRTStartup",
    ],
)

rust_binary(
    name = "gui_target_override",
    srcs = ["main.rs"],
    rustc_flags = ["-Clink-arg=/SUBSYSTEM:WINDOWS"],
)

config_setting(
    name = "release",
    values = {"compilation_mode": "opt"},
)

rust_binary(
    name = "profile_subsystem",
    srcs = ["profile.rs"],
    target_compatible_with = ["@platforms//os:windows"],
    rustc_flags = select({
        ":release": ["--codegen=link-arg=/SUBSYSTEM:WINDOWS"],
        "//conditions:default": [],
    }),
)

platform(
    name = "macos_arm64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:arm64"],
)
