load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

rust_binary(
    name = "gui",
    srcs = ["main.rs"],
)

rust_binary(
    name = "override_only",
    srcs = ["plain.rs"],
    rustc_flags = ["-Clink-arg=/SUBSYSTEM:WINDOWS"],
)

rust_binary(
    name = "override_with_entry",
    srcs = ["plain.rs"],
    rustc_flags = [
        "-Clink-arg=/SUBSYSTEM:WINDOWS",
        "-Clink-arg=/ENTRY:mainCRTStartup",
    ],
)

rust_binary(
    name = "gui_target_override",
    srcs = ["main.rs"],
    rustc_flags = ["-Clink-arg=/SUBSYSTEM:WINDOWS"],
)

config_setting(
    name = "windows_release",
    constraint_values = ["@platforms//os:windows"],
    values = {"compilation_mode": "opt"},
)

rust_binary(
    name = "profile_subsystem",
    srcs = ["profile.rs"],
    rustc_flags = select({
        ":windows_release": ["--codegen=link-arg=/SUBSYSTEM:WINDOWS"],
        "//conditions:default": [],
    }),
)

exports_files(["bin-link-args.patch"])

cargo_build_script(
    name = "profile_build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
)

rust_library(
    name = "shared_library",
    srcs = ["shared.rs"],
    deps = [":profile_build_script"],
)

rust_binary(
    name = "build_script_subsystem",
    srcs = ["build_script_main.rs"],
    deps = [":profile_build_script", ":shared_library"],
)

rust_binary(
    name = "library_consumer",
    srcs = ["plain.rs"],
    deps = [":shared_library"],
)
